# Copy this file to .env to run the writing agents on Microsoft Foundry (see README).
# Without these two settings everything runs on the built-in mock model.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-5.4-mini

# gpt-5 family models think before answering. "low" is the default; "minimal" (gpt-5, gpt-5-mini,
# gpt-5-nano) or "none" (gpt-5.1 and later) answers fastest. Leave it empty for a model without
# reasoning (such as gpt-4.1-mini).
# FOUNDRY_REASONING_EFFORT=minimal

# Public host names the MCP endpoint should answer to, comma-separated (for a deployed server).
# MCP_ALLOWED_HOSTS=
